        {
          "name": "Get Organization Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res.roles && res.roles.length > 0) {",
                  "        // Find member role for invitation",
                  "        const memberRole = res.roles.find(r => r.name === 'member') || res.roles[0];",
                  "        pm.environment.set('roleId', memberRole._id);",
                  "        console.log('✅ roleId set to:', memberRole.name, memberRole._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/roles?organizationId={{orgId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "roles"
              ],
              "query": [
                {
                  "key": "organizationId",
                  "value": "{{orgId}}"
                }
              ]
            }
          }
        },
