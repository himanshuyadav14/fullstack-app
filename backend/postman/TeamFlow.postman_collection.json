        {
          "name": "Signup User (Owner / Inviter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.environment.set('token', res.token);",
                  "    }",
                  "    if (res.user && res.user.id) {",
                  "        pm.environment.set('userId', res.user.id);",
                  "    }",
                  "    if (res.verificationToken) {",
                  "        pm.environment.set('verificationToken', res.verificationToken);",
                  "        console.log('✅ verificationToken saved:', res.verificationToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Himanshu Yadav\",\n  \"email\": \"himyadav.yh@gmail.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
