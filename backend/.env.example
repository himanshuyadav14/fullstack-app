PORT=5001
MONGO_URL=your-mongo-url

# Set to "development" only on your local machine (shows OTP in API responses for testing).
# Use "production" on any deployed server.
NODE_ENV=development

JWT_SECRET=a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
